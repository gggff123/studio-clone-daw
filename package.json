{
  "name": "studio-clone-daw",
  "private": true,
  "version": "0.1.0",
  "description": "Cubase Pro 12-inspired desktop DAW built with Tauri 2, Rust and TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:exe": "tauri build --no-bundle",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --workspace --all-targets",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -p studio-core",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
