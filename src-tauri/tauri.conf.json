{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Clone",
  "version": "0.1.0",
  "identifier": "com.studioclone.daw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Studio Clone - Untitled Project",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Cubase-inspired digital audio workstation",
    "longDescription": "Studio Clone is an original Cubase Pro 12-inspired digital audio workstation.",
    "icon": ["icons/icon.png"]
  }
}
